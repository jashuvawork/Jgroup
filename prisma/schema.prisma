generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Core J Ecosystem ───────────────────────────────────────────

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  auditLogs AuditLog[]
}

model Business {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  tagline     String?
  category    String
  logo        String?
  heroImage   String?
  route       String   @unique
  status      String   @default("active") // active, inactive, coming_soon
  sortOrder   Int      @default(0)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  theme       BusinessTheme?
  media       BusinessMedia[]
  services    BusinessService[]
  products    BusinessProduct[]
  categories  Category[]
  orders      Order[]
  events      Event[]
  eventBookings EventBooking[]
  cateringRequests CateringRequest[]
  foundationProjects FoundationProject[]
  donations   Donation[]
  volunteers  Volunteer[]
  reviews     Review[]
  enquiries   Enquiry[]
}

model BusinessTheme {
  id              String   @id @default(cuid())
  businessId      String   @unique
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  primaryColor    String   @default("#000000")
  secondaryColor  String   @default("#ffffff")
  accentColor     String?
  fontFamily      String?
  environment3d   String?  // celebration, food, community, custom
  backgroundStyle String?
  particleType    String?
}

model BusinessMedia {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       String   // hero, gallery, logo, product, event
  url        String
  alt        String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

model BusinessService {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Float?
  image       String?
  category    String?
  featured    Boolean  @default(false)
  status      String   @default("active")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  eventBookings EventBooking[]
}

model BusinessProduct {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  name        String
  description String?
  price       Float
  image       String?
  isStudent   Boolean  @default(false)
  isCombo     Boolean  @default(false)
  isFeatured  Boolean  @default(false)
  status      String   @default("active")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
}

model Category {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  description String?
  sortOrder  Int      @default(0)
  products   BusinessProduct[]
}

// ─── Customers & Orders ─────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders         Order[]
  eventBookings  EventBooking[]
  cateringRequests CateringRequest[]
  donations      Donation[]
  reviews        Review[]
  enquiries      Enquiry[]
}

model Order {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  status      String   @default("pending")
  total       Float
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items    OrderItem[]
  payments Payment[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   BusinessProduct? @relation(fields: [productId], references: [id])
  name      String
  quantity  Int      @default(1)
  price     Float
}

model Payment {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Float
  method    String
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

// ─── Events ───────────────────────────────────────────────────────

model Event {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  image       String?
  category    String?
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model EventBooking {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  serviceId   String?
  service     BusinessService? @relation(fields: [serviceId], references: [id])
  eventDate   DateTime?
  status      String   @default("enquiry")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CateringRequest {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  eventType   String?
  guestCount  Int?
  eventDate   DateTime?
  status      String   @default("enquiry")
  notes       String?
  createdAt   DateTime @default(now())
}

// ─── Foundation ───────────────────────────────────────────────────

model FoundationProject {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title       String
  description String?
  image       String?
  status      String   @default("active")
  impactCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Donation {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id])
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  amount      Float
  message     String?
  status      String   @default("completed")
  createdAt   DateTime @default(now())
}

model Volunteer {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  skills      String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}

model ImpactStat {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  value     Int      @default(0)
  icon      String?
  updatedAt DateTime @updatedAt
}

// ─── Shared ───────────────────────────────────────────────────────

model Review {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
}

model Coupon {
  id         String   @id @default(cuid())
  code       String   @unique
  discount   Float
  type       String   @default("percentage")
  businessId String?
  expiresAt  DateTime?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Enquiry {
  id         String   @id @default(cuid())
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  type       String   @default("general")
  name       String
  email      String?
  phone      String?
  message    String
  status     String   @default("new")
  createdAt  DateTime @default(now())
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Analytics {
  id        String   @id @default(cuid())
  page      String
  visitors  Int      @default(0)
  date      DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  admin     Admin?   @relation(fields: [adminId], references: [id])
  action    String
  entity    String?
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
}
