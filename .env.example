# Example environment variables — copy to .env

# ─── Database (Railway PostgreSQL) ───────────────────────────────
# Local: docker compose up -d, then use:
DATABASE_URL="postgresql://jgroup:jgroup_dev@localhost:5432/jgroup"
# Production (Railway): auto-injected as ${{ Postgres.DATABASE_URL }}

# ─── Auth ────────────────────────────────────────────────────────
AUTH_SECRET="change-this-to-a-random-secret-in-production"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# ─── Site (jgroup.space) ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production: https://jgroup.space

# ─── Payments (server-side only — never expose to client) ────────
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""

# ─── Railway deploy flag ─────────────────────────────────────────
# RAILWAY="true"
